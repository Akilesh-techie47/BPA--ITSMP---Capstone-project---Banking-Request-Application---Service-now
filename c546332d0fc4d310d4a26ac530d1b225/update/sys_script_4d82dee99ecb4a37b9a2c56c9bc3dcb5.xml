        <script><![CDATA[(function filterRequestsByRole(current) {
    if (gs.hasRole('admin')) return;

    var userId = gs.getUserID();

    if (gs.hasRole('x_2220006_bankin_0.branch_manager')) {
        current.addQuery('branch_manager', userId)
            .addOrCondition('assigned_officer', userId)
            .addOrCondition('requested_by', userId);
    } else if (gs.hasRole('x_2220006_bankin_0.branch_officer')) {
        current.addQuery('assigned_officer', userId)
            .addOrCondition('requested_by', userId);
    } else if (gs.hasRole('x_2220006_bankin_0.banking_customer')) {
        current.addQuery('requested_by', userId);
    }
})(current);
]]></script>
